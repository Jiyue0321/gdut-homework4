  "questions": [
    {
      "id": "hr-01",
      "agent": "hr",
      "competencies": ["岗位动机"],
      "text": "为什么选择这个岗位？如果同时拿到其他方向的 offer，你会怎么排序？"
    },
    {
      "id": "hr-02",
      "agent": "hr",
      "competencies": ["岗位动机"],
      "text": "你对我们这个岗位日常做的事情有多了解？说说你认为最难适应的部分。"
    },
    {
      "id": "hr-03",
      "agent": "hr",
      "competencies": ["团队协作", "沟通表达"],
      "text": "讲一次你和队友意见分歧的经历，最后是怎么收敛的？"
    },
    {
      "id": "hr-04",
      "agent": "hr",
      "competencies": ["团队协作"],
      "text": "团队里有人长期拖进度，但不归你管，你会怎么处理？"
    },
    {
      "id": "hr-05",
      "agent": "hr",
      "competencies": ["沟通表达"],
      "text": "用三分钟向一个完全不懂技术的人解释你最近做过的项目。"
    },
    {
      "id": "hr-06",
      "agent": "hr",
      "competencies": ["学习能力"],
      "text": "最近半年你主动学了什么？为什么学，学到了什么程度？"
    },
    {
      "id": "hr-07",
      "agent": "hr",
      "competencies": ["岗位动机", "学习能力"],
      "text": "如果入职后发现工作内容和你预期不一致，你会怎么办？"
    },
    {
      "id": "hr-08",
      "agent": "hr",
      "competencies": ["沟通表达"],
      "text": "你希望上级用什么样的方式给你反馈？反过来，你希望团队怎么评价你？"
    },
    {
      "id": "hr-09",
      "agent": "hr",
      "competencies": ["团队协作"],
      "text": "你更适应独立完成还是结对推进？分别举一个你做得最好的例子。"
    },
    {
      "id": "hr-10",
      "agent": "hr",
      "competencies": ["岗位动机"],
      "text": "你未来三年的职业规划是什么？这个岗位在其中扮演什么角色？"
    },
    {
      "id": "tech-01",
      "agent": "tech",
      "competencies": ["技术深度", "问题解决"],
      "text": "挑你简历里最有含金量的一个项目，讲讲它解决的核心问题和你的技术选型理由。"
    },
    {
      "id": "tech-02",
      "agent": "tech",
      "competencies": ["技术深度"],
      "text": "你项目里最复杂的一段逻辑是什么？如果让你重写，会怎么改？"
    },
    {
      "id": "tech-03",
      "agent": "tech",
      "competencies": ["工程实践"],
      "text": "线上出现了一个偶发报错，日志里只有零散线索，你的排查顺序是什么？"
    },
    {
      "id": "tech-04",
      "agent": "tech",
      "competencies": ["工程实践", "数据意识"],
      "text": "你怎么判断一次性能优化是真的有效？会看哪些指标？"
    },
    {
      "id": "tech-05",
      "agent": "tech",
      "competencies": ["系统设计"],
      "text": "设计一个支持多人同时编辑的待办清单，说说数据一致性怎么保证。"
    },
    {
      "id": "tech-06",
      "agent": "tech",
      "competencies": ["系统设计", "技术深度"],
      "text": "如果接口响应从 200ms 掉到 2s，你会从哪些层面定位问题？"
    },
    {
      "id": "tech-07",
      "agent": "tech",
      "competencies": ["问题解决"],
      "text": "描述一次你调试了很久才解决的 bug，关键转折是什么？"
    },
    {
      "id": "tech-08",
      "agent": "tech",
      "competencies": ["工程实践"],
      "text": "你写过的代码里，测试覆盖到什么程度？哪些部分你坚持要写测试？"
    },
    {
      "id": "tech-09",
      "agent": "tech",
      "competencies": ["学习能力", "技术深度"],
      "text": "挑一个你熟悉的框架，说说它的设计取舍，以及什么场景下不该用它。"
    },
    {
      "id": "tech-10",
      "agent": "tech",
      "competencies": ["数据意识"],
      "text": "你做过的工作里，有没有用数据证明效果的例子？数据是怎么采集的？"
    },
    {
      "id": "tech-11",
      "agent": "tech",
      "competencies": ["技术深度", "系统设计"],
      "text": "如果要给现有系统加缓存，你会先回答哪几个问题？可能带来什么新风险？"
    },
    {
      "id": "tech-12",
      "agent": "tech",
      "competencies": ["问题解决"],
      "text": "遇到一个没人做过、文档也很少的技术问题，你会怎么推进？"
    },
    {
      "id": "prs-01",
      "agent": "pressure",
      "competencies": ["抗压能力"],
      "text": "你简历上写「显著提升了效率」，显著是多少？没有数字的话，我很难相信。"
    },
    {
      "id": "prs-02",
      "agent": "pressure",
      "competencies": ["抗压能力", "沟通表达"],
      "text": "这个项目听起来是团队一起做的，你怎么证明核心部分是你做的？"
    },
    {
      "id": "prs-03",
      "agent": "pressure",
      "competencies": ["抗压能力"],
      "text": "假设入职第一周就让你独立负责一个他没接触过的模块，做不完就要担责，你怎么应对？"
    },
    {
      "id": "prs-04",
      "agent": "pressure",
      "competencies": ["抗压能力", "问题解决"],
      "text": "你刚才的回答里有个结论我并不认同，你能重新论证一遍吗？"
    },
    {
      "id": "prs-05",
      "agent": "pressure",
      "competencies": ["抗压能力"],
      "text": "如果这次面试结果是拒绝，你认为最可能的原因是什么？"
    },
    {
      "id": "prs-06",
      "agent": "pressure",
      "competencies": ["抗压能力", "团队协作"],
      "text": "上线前夜发现你负责的部分有严重缺陷，但改就要延期，你会怎么决策？"
    },
    {
      "id": "prs-07",
      "agent": "pressure",
      "competencies": ["抗压能力", "沟通表达"],
      "text": "用一分钟说服我：为什么我们应该把机会给你而不是给一个经验更丰富的人？"
    },
    {
      "id": "prs-08",
      "agent": "pressure",
      "competencies": ["抗压能力", "数据意识"],
      "text": "你提到的成果里，有多少能归因于你自己？请把功劳拆开讲。"
    }
  ]
